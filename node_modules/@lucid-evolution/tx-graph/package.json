{
  "name": "@lucid-evolution/tx-graph",
  "version": "0.1.1",
  "description": "Transaction graph tracing and rendering utilities for Lucid Evolution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cardano",
    "lucid",
    "transaction",
    "utxo",
    "graph",
    "trace"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lucid-evolution/cml": "0.1.1",
    "@lucid-evolution/core-types": "0.5.1",
    "@lucid-evolution/core-utils": "0.2.1",
    "@lucid-evolution/utils": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.8",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.4",
    "@lucid-evolution/provider": "0.4.1"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  }
}